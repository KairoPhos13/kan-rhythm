<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup Label="Project">
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Kan.Forge</RootNamespace>
    <AssemblyName>Kan.Forge</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- The tests/ subfolder is its own project: keep its sources (and its
         generated obj files) out of this project's default glob. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);tests/**</DefaultItemExcludes>
    <Description>kan!forge: the level editor's tabs (tracks, compose, design), the audio played along a level, and the media pipeline, on top of Kan.Core</Description>
    <Version>0.0.0</Version>
  </PropertyGroup>

  <ItemGroup Label="Project References">
    <!-- What a level is and how a play is judged (no osu! inside); it also brings libkan's native bridge. -->
    <ProjectReference Include="..\core\Kan.Core.csproj" />
    <!-- Compiles against the fork (game/client) like the ruleset does. -->
    <ProjectReference Include="..\client\osu.Game\osu.Game.csproj" />
  </ItemGroup>

  <ItemGroup Label="Package References">
    <!--
      ManagedBass (MIT): decode-only use for extracting audio from video
      containers. The native BASS library is already shipped and loaded by
      osu!framework, no new dependency surface (see game/docs/bass-licensing.md).
    -->
    <PackageReference Include="ppy.ManagedBass" Version="2022.1216.0" />
  </ItemGroup>
</Project>
