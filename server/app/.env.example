# kan! server: copy to .env and adjust. Never commit .env.

# HTTP port the NestJS process listens on (Caddy proxies to it in production).
PORT=3000

# Set to "cloudflare" only when a proxy we control (Cloudflare Tunnel) fronts
# the app: forwarded client IPs are then trusted for rate limiting and
# generated URLs use https. Empty (the default) never trusts them.
TRUST_PROXY=

# PostgreSQL connection (dev docker-compose.yml publishes port 55432).
DATABASE_URL=postgres://kan:kan@localhost:55432/kan

# OAuth client credentials the game client sends in /oauth/token.
# The game ships these as constants (KanEndpointConfiguration: "kan-client" /
# "kan-public-client"): the "secret" is public by nature: like osu!lazer's, the
# client is distributed to everyone. Real protection comes from user passwords
# and hashed bearer tokens, not from this value; keep it in sync with the client.
OAUTH_CLIENT_ID=kan-client
OAUTH_CLIENT_SECRET=kan-public-client

# Token lifetimes (seconds). Access tokens must stay valid for well over 30 s
# or the client re-authenticates on every request.
ACCESS_TOKEN_TTL_SECONDS=86400
REFRESH_TOKEN_TTL_SECONDS=2592000
# Score tokens are created when a play starts and consumed at submission.
SCORE_TOKEN_TTL_SECONDS=1800

# Storage driver: "local" (dev/tests) or "s3" (S3-compatible: Cloudflare R2 / AWS S3).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./data

# Only used with STORAGE_DRIVER=s3.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
# Expiry of the presigned download URLs the API redirects to.
DOWNLOAD_URL_EXPIRY_SECONDS=300
