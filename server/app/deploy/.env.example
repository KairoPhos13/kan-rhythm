# Production environment for deploy/docker-compose.prod.yml.
# Copy to deploy/.env and fill in real values. Never commit deploy/.env.

# PostgreSQL (the app connects as user "kan" on the internal network).
POSTGRES_PASSWORD=change-me-long-random

# OAuth client credentials the game client sends in POST /oauth/token.
# These are public by nature: the game ships them as constants
# (KanEndpointConfiguration: CLIENT_ID "kan-client", CLIENT_SECRET
# "kan-public-client") in every copy of the client, exactly like osu!lazer's.
# The "secret" is not a secret — the real protection is user passwords and
# hashed bearer tokens. Keep the values in sync with the client; only change
# them together with a client build.
OAUTH_CLIENT_ID=kan-client
OAUTH_CLIENT_SECRET=kan-public-client

# Token lifetimes (seconds).
ACCESS_TOKEN_TTL_SECONDS=86400
REFRESH_TOKEN_TTL_SECONDS=2592000
SCORE_TOKEN_TTL_SECONDS=1800

# Level files: "s3" (Cloudflare R2 / AWS S3) or "local" (docker volume).
STORAGE_DRIVER=s3
S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=kan-levels
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me
S3_FORCE_PATH_STYLE=true
# Expiry of the presigned download URLs the API redirects to.
DOWNLOAD_URL_EXPIRY_SECONDS=300
