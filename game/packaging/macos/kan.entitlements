<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  kan! hardened-runtime entitlements (game/docs/platform-builds.md).
  Applied by `codesign --options runtime --entitlements kan.entitlements`
  when the APPLE_* secrets are configured; unsigned builds ignore this file.

  com.apple.security.device.audio-input: the microphone, the whole point of
  kan!. Without it a hardened-runtime build gets silence from the mic.

  com.apple.security.cs.allow-jit: .NET (CoreCLR) compiles IL with a JIT,
  which the hardened runtime forbids unless this entitlement is granted.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
</dict>
</plist>
