<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup Label="Project">
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Kan.Core</RootNamespace>
    <AssemblyName>Kan.Core</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- The tests/ subfolder is its own project. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);tests/**</DefaultItemExcludes>
    <Description>kan! core — what a level is and how a play is judged, free of the game client: the score and design models, the live judge, timing, tracks and their edits, transcription drafts, and the bridge to libkan</Description>
    <Version>0.0.0</Version>
  </PropertyGroup>

  <!-- No reference to osu!: this assembly must build and be tested on its own. -->

  <ItemGroup Label="Native bridge">
    <!--
      libkan_forge_native is built by CMake from game/forge/native (make native).
      It rides along to the output ROOT (Link flattens the path) so P/Invoke
      finds it next to the assemblies.
    -->
    <None Include="..\forge\native\build\libkan_forge_native.so" Condition="Exists('..\forge\native\build\libkan_forge_native.so')"
          Link="libkan_forge_native.so" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="..\forge\native\build\libkan_forge_native.dylib" Condition="Exists('..\forge\native\build\libkan_forge_native.dylib')"
          Link="libkan_forge_native.dylib" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="..\forge\native\build\kan_forge_native.dll" Condition="Exists('..\forge\native\build\kan_forge_native.dll')"
          Link="kan_forge_native.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
</Project>
